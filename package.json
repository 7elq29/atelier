{
  "name": "atelier",
  "productName": "Atelier",
  "version": "0.1.0",
  "private": true,
  "description": "Atelier desktop app",
  "main": "./out/main/index.js",
  "author": "qingqin",
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3,node-pty && node scripts/patch-node-pty.js && bash scripts/ensure-atelier-electron-mac.sh || true",
    "dev": "bash scripts/dev-electron.sh",
    "dev:full": "bash scripts/dev-full.sh",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build && tsc -p tsconfig.e2e.json",
    "package": "npm run build && electron-builder --config electron-builder.yml",
    "test:e2e": "playwright test",
    "test:e2e:affected": "node scripts/e2e-affected.mjs",
    "test:e2e:affected:list": "node scripts/e2e-affected.mjs --list",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:e2e:new-session-modal": "playwright test e2e/session-lifecycle.spec.ts e2e/bug-new-session-path-history.spec.ts e2e/session-ready-hint.spec.ts e2e/minion-session.spec.ts e2e/packaged-app-local-tilde.spec.ts --workers=1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.212",
    "@atomic-editor/editor": "^0.6.2",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^11.3.0",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite-plugin-monaco-editor": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.47.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.1.2",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
